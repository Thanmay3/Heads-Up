# Copy to .env and adjust as needed.

# Default is a local SQLite file so development needs zero infrastructure.
# Postgres (start it with: docker compose up -d db):
# DATABASE_URL=postgresql+psycopg://headsup:headsup@localhost:5432/headsup
# DATABASE_URL=sqlite:///./data/headsup.db

# Comma-separated list of allowed browser origins for the API.
# CORS_ORIGINS=http://localhost:5173
